# ==============================================================================
# Rising Skills Backend — Environment Configuration Template
# Copy this file to .env and configure real credentials for local development.
# NEVER commit .env to version control.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_NAME=Rising Skills Backend
API_V1_PREFIX=/api/v1
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated list of allowed origins)
# In production, specify exact frontend domains (e.g. https://risingskills.com)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Connection (Supabase PostgreSQL)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres
# Direct connection for migrations (e.g. port 5432 session pooler vs direct)
DIRECT_DATABASE_URL=postgresql://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Supabase Auth & Integrations
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI Service Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
